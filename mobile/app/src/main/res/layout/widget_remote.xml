<?xml version="1.0" encoding="utf-8"?>
<!-- Controle da TV com as mesmas posições e ícones do controle do aplicativo:
     números em cima, volume e canais ao lado do direcional, voltar/casa/menu embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_remote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_play"
            android:tint="@color/widget_signal"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/widget_remote_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_remote_title"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_remote_power"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_pill"
            android:contentDescription="@string/widget_remote_power"
            android:padding="9dp"
            android:src="@drawable/widget_power"
            android:tint="@color/widget_alarm"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_remote_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_remote_empty"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_remote_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_remote_digit_1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_3"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_remote_digit_4"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_5"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_6"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_remote_digit_7"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_8"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_remote_digit_9"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="9"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/widget_remote_digit_0"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1" />
            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/widget_remote_volume_up"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/widget_remote_volume_up"
                    android:padding="12dp"
                    android:src="@drawable/widget_volume_up"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_mute"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/widget_remote_mute"
                    android:padding="12dp"
                    android:src="@drawable/widget_mute"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_volume_down"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/widget_remote_volume_down"
                    android:padding="12dp"
                    android:src="@drawable/widget_volume_down"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_circle">

                <TextView
                    android:id="@+id/widget_remote_enter"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_circle_key"
                    android:gravity="center"
                    android:text="@string/remote_ok"
                    android:textColor="@color/widget_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_remote_up"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:contentDescription="@string/widget_remote_up"
                    android:padding="13dp"
                    android:src="@drawable/widget_chevron_up"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_left"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="@string/widget_remote_left"
                    android:padding="13dp"
                    android:src="@drawable/widget_chevron_left"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_right"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@string/widget_remote_right"
                    android:padding="13dp"
                    android:src="@drawable/widget_chevron_right"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_down"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:contentDescription="@string/widget_remote_down"
                    android:padding="13dp"
                    android:src="@drawable/widget_chevron_down"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/widget_remote_channel_up"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/remote_channel_up"
                    android:padding="12dp"
                    android:src="@drawable/widget_chevron_up"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_channel_list"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/remote_channel_list"
                    android:padding="12dp"
                    android:src="@drawable/widget_list"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/widget_remote_channel_down"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_circle_key"
                    android:contentDescription="@string/remote_channel_down"
                    android:padding="12dp"
                    android:src="@drawable/widget_chevron_down"
                    android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">
                    <ImageView
                        android:id="@+id/widget_remote_back"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/widget_circle_key"
                        android:contentDescription="@string/remote_back"
                        android:padding="12dp"
                        android:src="@drawable/widget_arrow_left"
                        android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
                    <ImageView
                        android:id="@+id/widget_remote_home"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/widget_circle_key"
                        android:contentDescription="@string/remote_home"
                        android:padding="12dp"
                        android:src="@drawable/widget_home"
                        android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
                    <ImageView
                        android:id="@+id/widget_remote_menu"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/widget_circle_key"
                        android:contentDescription="@string/settings"
                        android:padding="12dp"
                        android:src="@drawable/widget_menu"
                        android:tint="@color/widget_ink"
            tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
