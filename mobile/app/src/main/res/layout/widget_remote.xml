<?xml version="1.0" encoding="utf-8"?>
<!-- Controle da TV com a MESMA ordem e as MESMAS medidas do controle do
     aplicativo (RemoteControlScreen): nome, energia centralizada (círculo),
     botão ABC embaixo dela, números, volume/direcional/canais e, por fim,
     voltar/casa/menu centralizados. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_remote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_play"
            android:tint="@color/widget_signal"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/widget_remote_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_remote_title"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_remote_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_remote_empty"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_remote_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- energia centralizada, como no app (círculo de 56dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_remote_power"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_circle_alert"
                android:contentDescription="@string/widget_remote_power"
                android:padding="15dp"
                android:src="@drawable/widget_power"
                android:tint="@color/widget_on_error_container"
            tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/widget_remote_abc"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_circle_key"
                android:gravity="center"
                android:text="@string/widget_remote_keypad_toggle"
                android:textColor="@color/widget_signal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- números: 1 a 9 e 0, iguais ao app (44dp de altura). Some quando
             o teclado está em letras, como no aplicativo. -->
        <LinearLayout
            android:id="@+id/widget_remote_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_digit_1" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="1" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_2" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="2" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_3" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="3" android:textColor="@color/widget_ink" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_digit_4" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="4" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="5" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_6" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="6" android:textColor="@color/widget_ink" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_digit_7" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="7" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_8" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="8" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:id="@+id/widget_remote_digit_9" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="9" android:textColor="@color/widget_ink" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_marginStart="4dp" android:layout_weight="1" />
                <TextView android:id="@+id/widget_remote_digit_0" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="0" android:textColor="@color/widget_ink" android:textSize="15sp" />
                <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_marginStart="4dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- letras: a mesma troca do botão ABC dentro do aplicativo -->
        <LinearLayout
            android:id="@+id/widget_remote_letters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_letter_q" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="q" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_w" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="w" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_e" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="e" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_r" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="r" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_t" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="t" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_y" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="y" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_u" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="u" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_i" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="i" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_o" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="o" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_p" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="p" android:textColor="@color/widget_ink" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_letter_a" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="a" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_s" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="s" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_d" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="d" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_f" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="f" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_g" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="g" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_h" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="h" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_j" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="j" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_k" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="k" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_l" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="l" android:textColor="@color/widget_ink" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_letter_z" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="z" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_x" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="x" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_c" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="c" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_v" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="v" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_b" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="b" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_n" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="n" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_letter_m" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="m" android:textColor="@color/widget_ink" android:textSize="13sp" />
            </LinearLayout>

            <!-- espaço / apagar / enter, como no app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_remote_text_space" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="3" android:background="@drawable/widget_pill" android:gravity="center" android:text="@string/widget_remote_space" android:textColor="@color/widget_ink" android:textSize="12sp" />
                <TextView android:id="@+id/widget_remote_text_backspace" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="⌫" android:textColor="@color/widget_ink" android:textSize="13sp" />
                <TextView android:id="@+id/widget_remote_text_enter" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:gravity="center" android:text="⏎" android:textColor="@color/widget_ink" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- volume | direcional | canais -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView android:id="@+id/widget_remote_volume_up" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/widget_remote_volume_up" android:padding="13dp" android:src="@drawable/widget_volume_up" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_mute" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/widget_remote_mute" android:padding="13dp" android:src="@drawable/widget_mute" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_volume_down" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/widget_remote_volume_down" android:padding="13dp" android:src="@drawable/widget_volume_down" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_circle">

                <TextView
                    android:id="@+id/widget_remote_enter"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_circle_key"
                    android:gravity="center"
                    android:text="@string/remote_ok"
                    android:textColor="@color/widget_signal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView android:id="@+id/widget_remote_up" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|center_horizontal" android:contentDescription="@string/widget_remote_up" android:padding="12dp" android:src="@drawable/widget_chevron_up" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_left" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|start" android:contentDescription="@string/widget_remote_left" android:padding="12dp" android:src="@drawable/widget_chevron_left" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_right" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|end" android:contentDescription="@string/widget_remote_right" android:padding="12dp" android:src="@drawable/widget_chevron_right" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_down" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|center_horizontal" android:contentDescription="@string/widget_remote_down" android:padding="12dp" android:src="@drawable/widget_chevron_down" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView android:id="@+id/widget_remote_channel_up" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/remote_channel_up" android:padding="13dp" android:src="@drawable/widget_chevron_up" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_channel_list" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/remote_channel_list" android:padding="13dp" android:src="@drawable/widget_list" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_channel_down" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/remote_channel_down" android:padding="13dp" android:src="@drawable/widget_chevron_down" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>

        <!-- voltar / casa / menu centralizados, como no app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView android:id="@+id/widget_remote_back" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/remote_back" android:padding="14dp" android:src="@drawable/widget_arrow_left" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_home" android:layout_width="62dp" android:layout_height="62dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/remote_home" android:padding="15dp" android:src="@drawable/widget_home" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
                <ImageView android:id="@+id/widget_remote_menu" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/widget_circle_key" android:contentDescription="@string/settings" android:padding="14dp" android:src="@drawable/widget_menu" android:tint="@color/widget_ink" tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
