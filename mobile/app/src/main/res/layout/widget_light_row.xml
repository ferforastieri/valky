<?xml version="1.0" encoding="utf-8"?>
<!-- Uma lâmpada no widget: nome, estado e o botão de ligar/desligar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_light_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/widget_bulb_tile">

        <ImageView
            android:id="@+id/widget_light_bulb"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_bulb_off"
            android:tint="@color/widget_muted"
            tools:ignore="UseAppTint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_light_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_light_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_light_power"
        android:layout_width="42dp"
        android:layout_height="24dp"
        android:contentDescription="@string/widget_light_toggle"
        android:src="@drawable/widget_switch_off" />
</LinearLayout>
