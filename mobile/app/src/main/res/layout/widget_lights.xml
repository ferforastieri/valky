<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho e lista de lâmpadas. A lista é uma coleção (ListView) alimentada
     pelo LightsWidgetService: rola e mostra todas as lâmpadas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_lights_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_bulb_on"
            android:tint="@color/widget_signal"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/widget_lights_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_lights_title"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_lights_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_pill"
            android:contentDescription="@string/widget_refresh"
            android:padding="7dp"
            android:src="@drawable/widget_refresh"
            android:tint="@color/widget_muted"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_lights_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_lights_empty"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/widget_lights_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
