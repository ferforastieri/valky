<resources>
    <style name="Theme.Valky" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F3FC</item>
        <item name="android:navigationBarColor">#F5F3FC</item>
    </style>
    <style name="Theme.Valky.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/valky_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/valky_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/valky_surface</item>
        <item name="postSplashScreenTheme">@style/Theme.Valky</item>
    </style>
    <style name="Theme.Valky.Alarm" parent="Theme.Valky">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
