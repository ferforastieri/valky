<?xml version="1.0" encoding="utf-8"?>
<!-- Pulso da lâmpada acesa no widget: o brilho alterna entre dois quadros,
     como uma lâmpada viva. A cor vem do próprio estado atual da lâmpada. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:drawable="@drawable/widget_bulb_glow_soft" android:duration="750" />
    <item android:drawable="@drawable/widget_bulb_glow_full" android:duration="750" />
</animation-list>
