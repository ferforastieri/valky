---
import { Download } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../content/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const pt = locale === 'pt-BR';

// Nada de texto próprio aqui: a página apresenta a documentação versionada em
// docs/*.md (ver web/scripts/sync-docs.mjs). O português é a fonte; quem está em
// inglês recebe o mesmo conteúdo com um aviso no topo.
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const sections = await Promise.all(
  docs.map(async (doc) => ({ doc, ...(await render(doc)) })),
);

const text = {
  title: pt ? 'Documentação do Valky' : 'Valky documentation',
  description: 'Instalação, arquitetura, API, recursos, segurança e desenvolvimento do Valky.',
  eyebrow: 'GUIA OPERACIONAL · API V1',
  intro: 'Instalar o servidor, preparar câmeras e iluminação, conectar o Android, integrar a API e contribuir no projeto.',
  onThisPage: 'Nesta página',
  status: 'Documentação versionada no repositório',
  notice: 'The documentation is maintained in Portuguese; the files in the repository are the source.',
  source: 'Editar no GitHub',
};

const repository = 'https://github.com/ferforastieri/valky/blob/main';
---
<BaseLayout locale={locale} title={`${text.title} | Valky`} description={text.description}>
  <main class="docs-shell">
    <header class="docs-hero">
      <div>
        <p class="eyebrow"><span></span>{text.eyebrow}</p>
        <h1>{text.title}</h1>
        <p>{text.intro}</p>
      </div>
      <div class="docs-status" aria-label={pt ? 'Estado da documentação' : 'Documentation status'}>
        <span><i></i>{pt ? text.status : 'Documentation versioned in the repository'}</span>
        <a href="/openapi.yaml" download>OpenAPI 3.1 <Download size={16}/></a>
      </div>
    </header>

    {!pt && <p class="docs-notice">{text.notice}</p>}

    <div class="docs-grid">
      <aside class="docs-toc">
        <p>{text.onThisPage}</p>
        <nav>
          {sections.map(({ doc }, index) => (
            <a href={`#${doc.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{doc.data.title}</a>
          ))}
        </nav>
      </aside>

      <article class="docs-content">
        {sections.map(({ doc, Content }, index) => (
          <section id={doc.id}>
            <div class="docs-heading">
              <div><span>{String(index + 1).padStart(2, '0')}</span><h2>{doc.data.title}</h2></div>
              <a class="docs-source" href={`${repository}/docs/${doc.id}.md`} rel="noreferrer">{text.source}</a>
            </div>
            <Content />
          </section>
        ))}
      </article>
    </div>
  </main>

  <Navigation locale={locale} current="docs" />

  <script>
    const root = document.documentElement;
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => root.dataset.theme === 'dark' || (root.dataset.theme === 'auto' && systemTheme.matches);
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      root.dataset.theme = isDark() ? 'light' : 'dark';
      localStorage.setItem('valky-theme', root.dataset.theme);
    });
  </script>
</BaseLayout>
