---
import { ArrowLeft, ArrowRight, BellRing, Check, ChevronDown, Download, ShieldCheck } from '@lucide/astro';
import { copy, type Locale } from '../content/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const command = 'curl -fsSL https://valkyris.vercel.app/install.sh | sh';
const heroLines = locale === 'pt-BR' ? ['Sua casa avisa.', 'Seus dados ficam.'] : ['Your home speaks.', 'Your data stays.'];
---
<BaseLayout locale={locale} title={t.metaTitle} description={t.metaDescription}>
  <main class="landing-shell">
    <section class="hero" id="overview">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span>{t.heroEyebrow}</p>
        <h1>{heroLines.map(line => <span>{line}</span>)}</h1>
        <p class="lede">{t.heroBody}</p>
        <div class="hero-actions">
          <a class="button dark" href="#install"><Download size={17}/>{t.install}</a>
          <a class="button quiet" href="https://github.com/ferforastieri/valkyris">{t.github}<ArrowRight size={17}/></a>
        </div>
        <div class="trust-row"><ShieldCheck size={17}/><span>MIT · ONVIF Profile S · LAN / VPN</span></div>
        <p class="hero-interaction-hint"><span class="status-dot"></span>{locale === 'pt-BR' ? 'Clique em uma tela para trazê-la à frente' : 'Click a screen to bring it forward'}</p>
      </div>
      <div class="hero-screens reveal delayed" aria-label={locale === 'pt-BR' ? 'Telas interativas do aplicativo Valkyris' : 'Interactive Valkyris application screens'}>
        <button class="hero-phone is-front" type="button" aria-pressed="true" aria-label={locale === 'pt-BR' ? 'Trazer visão geral para frente' : 'Bring overview to front'}>
          <picture><img class="theme-screenshot" src="/screenshots/overview-light.png" data-light-src="/screenshots/overview-light.png" data-dark-src="/screenshots/overview-dark.png" alt={locale === 'pt-BR' ? 'Visão geral real do Valkyris' : 'Actual Valkyris overview'} width="1170" height="2532"/></picture>
        </button>
        <button class="hero-phone" type="button" aria-pressed="false" aria-label={locale === 'pt-BR' ? 'Trazer notificações para frente' : 'Bring notifications to front'}>
          <picture><img class="theme-screenshot" src="/screenshots/events-light.png" data-light-src="/screenshots/events-light.png" data-dark-src="/screenshots/events-dark.png" alt={locale === 'pt-BR' ? 'Central real de notificações do Valkyris' : 'Actual Valkyris notification center'} width="1170" height="2532"/></picture>
        </button>
      </div>
    </section>

    <section class="app-section section" id="app">
      <div class="app-copy"><p class="eyebrow"><span></span>ANDROID NATIVE</p><h2>{t.appTitle}</h2><p>{t.appBody}</p><div class="app-assurances"><article><ShieldCheck size={20}/><div><strong>{t.principlesTitle}</strong><p>{t.principlesBody}</p></div></article><article><BellRing size={20}/><div><strong>{locale === 'pt-BR' ? 'Alertas do seu jeito' : 'Alerts on your terms'}</strong><p>{t.detectBody}</p></div></article></div><ul><li><Check size={16}/>Kotlin + Jetpack Compose</li><li><Check size={16}/>UnifiedPush / ntfy</li><li><Check size={16}/>LL-HLS authenticated</li></ul></div>
      <div class="app-carousel" aria-roledescription="carousel" aria-label={locale === 'pt-BR' ? 'Telas reais do aplicativo' : 'Actual application screens'}>
        <div class="carousel-viewport"><div class="carousel-track">
          <button class="app-capture carousel-slide is-active" type="button" data-slide-index="0" aria-label={locale === 'pt-BR' ? 'Tela 1 de 4. Clique para avançar.' : 'Screen 1 of 4. Click to advance.'}><picture><img class="theme-screenshot" src="/screenshots/cameras-light.png" data-light-src="/screenshots/cameras-light.png" data-dark-src="/screenshots/cameras-dark.png" alt={locale === 'pt-BR' ? 'Tela real de câmeras do Valkyris' : 'Actual Valkyris cameras screen'} width="1170" height="2532"/></picture><span class="capture-caption">{locale === 'pt-BR' ? 'Câmeras e snapshots' : 'Cameras and snapshots'}</span></button>
          <button class="app-capture carousel-slide is-next" type="button" data-slide-index="1" aria-label={locale === 'pt-BR' ? 'Tela 2 de 4. Clique para selecionar.' : 'Screen 2 of 4. Click to select.'}><picture><img class="theme-screenshot" src="/screenshots/events-light.png" data-light-src="/screenshots/events-light.png" data-dark-src="/screenshots/events-dark.png" alt={locale === 'pt-BR' ? 'Central de eventos do Valkyris' : 'Valkyris event center'} width="1170" height="2532"/></picture><span class="capture-caption">{locale === 'pt-BR' ? 'Alertas e acesso à câmera' : 'Alerts and camera access'}</span></button>
          <button class="app-capture carousel-slide is-hidden" type="button" data-slide-index="2" aria-label={locale === 'pt-BR' ? 'Tela 3 de 4. Clique para selecionar.' : 'Screen 3 of 4. Click to select.'}><picture><img class="theme-screenshot" src="/screenshots/rules-light.png" data-light-src="/screenshots/rules-light.png" data-dark-src="/screenshots/rules-dark.png" alt={locale === 'pt-BR' ? 'Tela real de regras do Valkyris' : 'Actual Valkyris rules screen'} width="1170" height="2532"/></picture><span class="capture-caption">{locale === 'pt-BR' ? 'Regras locais' : 'Local rules'}</span></button>
          <button class="app-capture carousel-slide is-prev" type="button" data-slide-index="3" aria-label={locale === 'pt-BR' ? 'Tela 4 de 4. Clique para selecionar.' : 'Screen 4 of 4. Click to select.'}><picture><img class="theme-screenshot" src="/screenshots/settings-light.png" data-light-src="/screenshots/settings-light.png" data-dark-src="/screenshots/settings-dark.png" alt={locale === 'pt-BR' ? 'Tela real de ajustes' : 'Actual settings screen'} width="1170" height="2532"/></picture><span class="capture-caption">{locale === 'pt-BR' ? 'Casa e preferências' : 'Home and preferences'}</span></button>
        </div><button class="carousel-hit carousel-hit-prev" type="button" aria-label={locale === 'pt-BR' ? 'Selecionar a tela à esquerda' : 'Select the screen on the left'}></button><button class="carousel-hit carousel-hit-next" type="button" aria-label={locale === 'pt-BR' ? 'Selecionar a tela à direita' : 'Select the screen on the right'}></button></div>
        <div class="carousel-controls">
          <button class="carousel-arrow carousel-prev" type="button" aria-label={locale === 'pt-BR' ? 'Tela anterior' : 'Previous screen'}><ArrowLeft size={18}/></button>
          <div class="carousel-dots" aria-label={locale === 'pt-BR' ? 'Escolher tela' : 'Choose screen'}>{[0,1,2,3].map((index)=><button type="button" class={index === 0 ? 'is-active' : ''} data-slide={index} aria-label={`${locale === 'pt-BR' ? 'Ir para tela' : 'Go to screen'} ${index+1}`} aria-current={index === 0 ? 'true' : undefined}></button>)}</div>
          <button class="carousel-arrow carousel-next" type="button" aria-label={locale === 'pt-BR' ? 'Próxima tela' : 'Next screen'}><ArrowRight size={18}/></button>
        </div>
      </div>
    </section>

    <section class="install section" id="install">
      <div class="install-header">
        <div><p class="eyebrow"><span></span>QUICK START</p><h2>{t.setupTitle}</h2></div>
        <p class="install-intro">{locale === 'pt-BR' ? 'Um comando prepara o servidor, a mídia e as atualizações. Depois, basta concluir a conexão pelo Android.' : 'One command prepares the server, media, and updates. Then finish the connection from Android.'}</p>
      </div>
      <div class="steps">{t.steps.map(([title,body],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
      <div class="terminal"><div class="terminal-bar"><span></span><span></span><span></span><b>install.sh</b></div><div class="terminal-command"><code>{command}</code><button class="copy-command" data-command={command} aria-label="Copy install command">COPY</button></div><div class="terminal-output"><span>✓ Docker Compose detected</span><span>✓ TLS identity generated</span><span>✓ Valkyris is listening on :8443</span></div></div>
    </section>

    <section class="faq section" id="faq"><div><p class="eyebrow"><span></span>FAQ · ONVIF PROFILE S</p><h2>{t.faqTitle}</h2></div><div class="faq-list">{t.faq.map(([q,a])=><details><summary>{q}<ChevronDown size={18}/></summary><p>{a}</p></details>)}</div></section>
  </main>

  <Navigation locale={locale} current="home" />

  <script>
    const root=document.documentElement;
    const systemTheme=matchMedia('(prefers-color-scheme: dark)');
    const isDarkTheme=()=>root.dataset.theme==='dark'||(root.dataset.theme==='auto'&&systemTheme.matches);
    const syncThemeScreenshots=()=>document.querySelectorAll<HTMLImageElement>('.theme-screenshot').forEach(image=>{const next=isDarkTheme()?image.dataset.darkSrc:image.dataset.lightSrc;if(next&&image.getAttribute('src')!==next)image.src=next});
    syncThemeScreenshots();
    systemTheme.addEventListener('change',()=>{if(root.dataset.theme==='auto')syncThemeScreenshots()});
    document.querySelector('.theme-toggle')?.addEventListener('click',()=>{root.dataset.theme=isDarkTheme()?'light':'dark';localStorage.setItem('valkyris-theme',root.dataset.theme);syncThemeScreenshots()});
    document.querySelector('.copy-command')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;await navigator.clipboard.writeText(button.dataset.command||'');const previous=button.textContent;button.textContent='COPIED';setTimeout(()=>button.textContent=previous,1400)});
    const heroPhones=[...document.querySelectorAll<HTMLButtonElement>('.hero-phone')];
    heroPhones.forEach(phone=>phone.addEventListener('click',()=>heroPhones.forEach(item=>{const active=item===phone;item.classList.toggle('is-front',active);item.setAttribute('aria-pressed',String(active))})));
    const carousel=document.querySelector<HTMLElement>('.app-carousel');
    if(carousel){
      const slides=[...carousel.querySelectorAll<HTMLElement>('.carousel-slide')];
      const dots=[...carousel.querySelectorAll<HTMLButtonElement>('.carousel-dots button')];
      const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
      const hoverCapable=matchMedia('(hover: hover)');
      let slide=0;
      let autoPaused=reducedMotion.matches;
      let autoTimer:number|undefined;
      const show=(next:number)=>{
        slide=(next+dots.length)%dots.length;
        slides.forEach((item,index)=>{const delta=(index-slide+dots.length)%dots.length;item.classList.remove('is-active','is-prev','is-next','is-hidden');item.classList.add(delta===0?'is-active':delta===1?'is-next':delta===dots.length-1?'is-prev':'is-hidden');item.setAttribute('aria-current',delta===0?'true':'false')});
        dots.forEach((dot,index)=>{dot.classList.toggle('is-active',index===slide);if(index===slide)dot.setAttribute('aria-current','true');else dot.removeAttribute('aria-current')});
      };
      const stopTimer=()=>{if(autoTimer!==undefined){window.clearTimeout(autoTimer);autoTimer=undefined}};
      const schedule=()=>{stopTimer();if(!autoPaused&&!document.hidden&&!carousel.matches(':focus-within')&&(!hoverCapable.matches||!carousel.matches(':hover')))autoTimer=window.setTimeout(()=>{show(slide+1);schedule()},4800)};
      const interact=(next:number)=>{show(next);schedule()};
      carousel.querySelector('.carousel-prev')?.addEventListener('click',()=>interact(slide-1));
      carousel.querySelector('.carousel-next')?.addEventListener('click',()=>interact(slide+1));
      carousel.querySelector('.carousel-hit-prev')?.addEventListener('click',()=>interact(slide-1));
      carousel.querySelector('.carousel-hit-next')?.addEventListener('click',()=>interact(slide+1));
      dots.forEach(dot=>dot.addEventListener('click',()=>interact(Number(dot.dataset.slide))));
      slides.forEach(item=>item.addEventListener('click',()=>{const selected=Number(item.dataset.slideIndex);interact(selected===slide?slide+1:selected)}));
      carousel.addEventListener('pointerenter',stopTimer);
      carousel.addEventListener('pointerleave',schedule);
      carousel.addEventListener('focusin',stopTimer);
      carousel.addEventListener('focusout',event=>{if(!carousel.contains((event as FocusEvent).relatedTarget as Node|null))schedule()});
      document.addEventListener('visibilitychange',()=>document.hidden?stopTimer():schedule());
      reducedMotion.addEventListener('change',event=>{autoPaused=event.matches;schedule()});
      schedule();
    }
  </script>
</BaseLayout>
