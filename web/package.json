{
  "name": "@valkyris/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "sync-assets": "node scripts/sync-public-assets.mjs",
    "dev": "pnpm sync-assets && astro dev",
    "build": "pnpm sync-assets && astro check && astro build",
    "preview": "astro preview",
    "test": "pnpm build && pnpm build:viewer && node --test tests/*.test.mjs",
    "build:viewer": "astro check --root . && astro build --config astro.viewer.config.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@lucide/astro": "^0.556.0",
    "astro": "^5.13.5",
    "typescript": "^5.9.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20"
  }
}
