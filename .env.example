VALKY_LISTEN=:8443
VALKY_DATA_DIR=/data
VALKY_DATABASE=/data/valky.db
VALKY_TLS_CERT=/data/tls/server.crt
VALKY_TLS_KEY=/data/tls/server.key
VALKY_MASTER_KEY_FILE=/data/secrets/master.key
VALKY_MEDIA_API=http://mediamtx:9997
VALKY_MEDIA_PLAYBACK=http://mediamtx:9996
VALKY_MEDIA_WEBRTC=http://mediamtx:8889
VALKY_MEDIA_RTSP=rtsp://mediamtx:8554
VALKY_MEDIA_RECORDINGS=/data/recordings
VALKY_RELEASE_API=https://api.github.com/repos/ferforastieri/valky/releases/latest
# Caminho dentro do container. Copie a conta de serviço para este local no volume valky-data.
VALKY_FIREBASE_CREDENTIALS_FILE=/data/secrets/firebase-service-account.json

# Código de instalação: quando definido, é exigido para criar o PRIMEIRO
# administrador. O instalador gera e imprime este valor.
VALKY_SETUP_TOKEN=

# Compose: advertised LAN/VPN addresses for WebRTC media, comma separated.
VALKY_WEBRTC_HOSTS=
# Static viewer directory when running the Go backend outside Docker.
VALKY_WEB_DIR=/opt/valky/web
