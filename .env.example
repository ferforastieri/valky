VALKYRIS_LISTEN=:8443
VALKYRIS_DATA_DIR=/data
VALKYRIS_DATABASE=/data/valkyris.db
VALKYRIS_TLS_CERT=/data/tls/server.crt
VALKYRIS_TLS_KEY=/data/tls/server.key
VALKYRIS_MASTER_KEY_FILE=/data/secrets/master.key
VALKYRIS_MEDIA_URL=http://mediamtx:8888
VALKYRIS_MEDIA_API=http://mediamtx:9997
VALKYRIS_MEDIA_RECORDINGS=/data/recordings
VALKYRIS_UPDATER_URL=http://updater:8080
# Generate a private random value for production. The installer fills this automatically.
VALKYRIS_UPDATER_TOKEN=
VALKYRIS_RELEASE_API=https://api.github.com/repos/ferforastieri/valkyris/releases/latest
